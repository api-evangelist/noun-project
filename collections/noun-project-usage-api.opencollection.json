{
  "opencollection": "1.0.0",
  "info": {
    "name": "Noun Project API V2 Autocomplete Usage API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Usage",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Client Usage",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.thenounproject.com/v2/client/usage",
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Return the calling client key's current usage and limits for the hourly, daily, and monthly windows."
        }
      ]
    }
  ],
  "bundled": true
}